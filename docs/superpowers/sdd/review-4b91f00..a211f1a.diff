+    def test_refresh_preset_detects_front_month(self):
+        svc = MarketService()
+        svc.load_instruments([
+            {"instrumentID": "IF2608", "exchangeID": "CFFEX", "productID": "IF", "expireDate": "20260821", "isTrading": 1},
