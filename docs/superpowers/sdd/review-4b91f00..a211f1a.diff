+    def test_refresh_preset_skips_non_trading(self):
+        svc = MarketService()
+        svc.load_instruments([
+            {"instrumentID": "IF2608", "exchangeID": "CFFEX", "productID": "IF", "expireDate": "20260821", "isTrading": 0},
