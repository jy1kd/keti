+    useUserPrefsStore.getState().loadFromLocalStorage()
+    expect(useUserPrefsStore.getState().collections).toEqual([
+      { id: 'coll-default', name: '默认收藏夹', instrumentIDs: ['au2406', 'rb2406'] },
