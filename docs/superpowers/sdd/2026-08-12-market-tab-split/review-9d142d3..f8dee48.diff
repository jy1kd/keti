     switch (action.type) {
         case 'market-view':
             return showAndSend(ctx, index_1.IPC_CHANNELS.MENU_MARKET_VIEW, action.view);
         case 'open-floating':
             return showAndSend(ctx, index_1.IPC_CHANNELS.MENU_OPEN_FLOATING, action.tab);
         case 'open-market-window':
             if (ctx.windowManager) {
