 function readCssBlock(selector: string): string {
   const css = readFileSync(resolve(__dirname, 'styles.css'), 'utf-8')
   const escaped = selector.replace(/\./g, '\\.')
   const re = new RegExp(`${escaped}\\s*\\{([^}]*)\\}`)
