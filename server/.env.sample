# SimNow CTP 连接配置模板
# 复制为 .env 并填入实际值: cp .env.sample .env

# 经纪商代码（SimNow 固定为 9999）
CTP_BROKER_ID=9999

# 行情前置地址（7x24 测试环境）
CTP_MD_FRONT=tcp://182.254.243.31:40011

# 交易前置地址（7x24 测试环境）
CTP_TD_FRONT=tcp://182.254.243.31:40001

# SimNow 账号（注册获取: https://www.simnow.com.cn）
CTP_USER_ID=your_user_id_here
CTP_PASSWORD=your_password_here

# 测试合约（逗号分隔多个合约，第一个用于报单）
CTP_TEST_INSTRUMENT=au2506

# 应用ID（认证用，默认即可）
CTP_APP_ID=simnow_client
CTP_AUTH_CODE=0000000000000000

# ── 自动切换地址（start.py 使用） ──────────────────────────
# 第一套：真实交易时段（工作日 09:00-16:00）
CTP_MD_FRONT_PRIMARY=tcp://182.254.243.31:30011
CTP_TD_FRONT_PRIMARY=tcp://182.254.243.31:30001

# 第二套：扩展时段（工作日 16:00-次日09:00 + 周末全天）
CTP_MD_FRONT_SECONDARY=tcp://182.254.243.31:40011
CTP_TD_FRONT_SECONDARY=tcp://182.254.243.31:40001
